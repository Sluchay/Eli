# Настройки pnpm для проекта.
#
# store-dir + node-linker=hoisted + symlink=false — вынужденная, но безвредная
# комбинация: так проект ставится и на Windows, где создание симлинков запрещено
# политикой системы (ошибка EPERM при обычной установке pnpm). Побочный эффект —
# плоский node_modules, как у npm. На Linux и в Docker работает так же.

store-dir=.pnpm-store
node-linker=hoisted
symlink=false
