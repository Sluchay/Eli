# ── База данных ──────────────────────────────────────────────────────────────
# Путь к файлу SQLite указан относительно каталога prisma/schema.prisma.
# Для перехода на PostgreSQL замените строку на postgresql://user:pass@host:5432/eli
# и поменяйте provider в prisma/schema.prisma.
DATABASE_URL="file:../data/eli.db"

# ── Безопасность ─────────────────────────────────────────────────────────────
# Случайная строка не короче 32 символов. Сгенерировать:
# node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
AUTH_SECRET="замените-на-случайную-строку"

# ── Первый администратор ─────────────────────────────────────────────────────
# Создаётся при выполнении pnpm db:seed. Пароль обязательно сменить после входа.
ADMIN_EMAIL="admin@eli.local"
ADMIN_INITIAL_PASSWORD="eli-admin-2024"

# ── Сайт ─────────────────────────────────────────────────────────────────────
# Часовой пояс ресторана: все расчёты «открыто сейчас» идут только через него.
TZ="Europe/Moscow"
SITE_URL="http://localhost:3000"

# ── Файлы ────────────────────────────────────────────────────────────────────
UPLOAD_DIR="./data/uploads"
STORAGE_DRIVER="local"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION=""
# S3_KEY=""
# S3_SECRET=""

# ── Уведомления (необязательно) ──────────────────────────────────────────────
# Если не заполнены — интеграция просто выключена, сайт работает как обычно.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
